# E-Commerce Order and Return System — Environment Configuration
# Copy this file to .env and configure for your deployment environment

# Application Settings
APP_NAME="E-Commerce Order and Return System"
APP_ENV=production
DEBUG=false
SECRET_KEY="generate-a-secure-random-secret-key-here"

# Database Configuration
# Default: Local High-Performance SQLite with WAL Mode
DATABASE_URL="sqlite:///ecommerce.db"
DATABASE_TIMEOUT=30
DATABASE_WAL_MODE=true

# Server Configuration
SERVER_HOST="0.0.0.0"
SERVER_PORT=8501

# Pricing & Tax Configuration
GST_PERCENTAGE=18.0
FREE_DELIVERY_THRESHOLD=999.0
STANDARD_DELIVERY_FEE=49.0
EXPRESS_DELIVERY_FEE=99.0

# Return & Logistics Policy
RETURN_WINDOW_DAYS=14
RESTOCK_ON_RECEIPT=true

# Payment Gateway Configuration (Optional - set when live gateway enabled)
PAYMENT_GATEWAY_PROVIDER="simulated" # Options: simulated | razorpay | stripe
PAYMENT_GATEWAY_KEY_ID=""
PAYMENT_GATEWAY_KEY_SECRET=""
PAYMENT_WEBHOOK_SECRET=""

